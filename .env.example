# Enable the SMS authentication flow. Vite reads this value at build time.
VITE_USE_SMS_LOGIN=

# ZIPCO backend base URL. Do not include a trailing slash.
VITE_API_URL=
VERCEL_OIDC_TOKEN=
# Local dev only: set VITE_API_URL=/local-api and point this at the local API;
# Vite forwards /local-api there, avoiding CORS against a production-mode API.
LOCAL_API_PROXY_TARGET=
